PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=contasys_produccion

JWT_SECRET=
JWT_EXPIRES_IN=8h

NODE_ENV=development
# Orígenes adicionales separados por comas. En producción usar HTTPS.
# Dejar vacío cuando frontend y API comparten origen.
CORS_ORIGIN=
# La API siempre bloquea los pagos simulados cuando NODE_ENV=production.
CONTASYS_SIMULAR_PAGOS=true
# 0 desactiva la evaluación periódica de presupuestos activos vigentes.
CONTASYS_ALERTAS_INTERVALO_MS=0
CONTASYS_ALERTAS_LOTE=25
